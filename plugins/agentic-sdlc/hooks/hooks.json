{
  "version": 1,
  "hooks": {
    "sessionEnd": [
      {
        "type": "command",
        "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/scan-secrets.sh\"",
        "windows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/scan-secrets.ps1\"",
        "linux": "bash \"${PLUGIN_ROOT}/hooks/scripts/scan-secrets.sh\"",
        "osx": "bash \"${PLUGIN_ROOT}/hooks/scripts/scan-secrets.sh\"",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/scripts/scan-secrets.sh\"",
        "powershell": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/scan-secrets.ps1\"",
        "cwd": ".",
        "env": {
          "SCAN_MODE": "warn",
          "SCAN_SCOPE": "diff"
        },
        "timeout": 60,
        "timeoutSec": 60
      },
      {
        "type": "command",
        "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/scan-pii.sh\"",
        "windows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/scan-pii.ps1\"",
        "linux": "bash \"${PLUGIN_ROOT}/hooks/scripts/scan-pii.sh\"",
        "osx": "bash \"${PLUGIN_ROOT}/hooks/scripts/scan-pii.sh\"",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/scripts/scan-pii.sh\"",
        "powershell": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/scan-pii.ps1\"",
        "cwd": ".",
        "env": {
          "SCAN_MODE": "warn",
          "SCAN_SCOPE": "diff"
        },
        "timeout": 60,
        "timeoutSec": 60
      }
    ]
  }
}
