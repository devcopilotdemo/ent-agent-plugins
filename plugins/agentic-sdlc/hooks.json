{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "shell",
        "bash": "bash -c 'r=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\"; bash \"$r/hooks/scripts/guard-commit.sh\"'",
        "powershell": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"$r=if($env:CLAUDE_PLUGIN_ROOT){$env:CLAUDE_PLUGIN_ROOT}else{$env:PLUGIN_ROOT}; & \\\"$r/hooks/scripts/guard-commit.ps1\\\"\"",
        "cwd": ".",
        "env": {
          "SCAN_MODE": "block",
          "SCAN_SCOPE": "staged"
        },
        "timeoutSec": 60
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash -c 'r=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\"; bash \"$r/hooks/scripts/scan-secrets.sh\"'",
        "powershell": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"$r=if($env:CLAUDE_PLUGIN_ROOT){$env:CLAUDE_PLUGIN_ROOT}else{$env:PLUGIN_ROOT}; & \\\"$r/hooks/scripts/scan-secrets.ps1\\\"\"",
        "cwd": ".",
        "env": {
          "SCAN_MODE": "warn",
          "SCAN_SCOPE": "diff"
        },
        "timeoutSec": 60
      },
      {
        "type": "command",
        "bash": "bash -c 'r=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\"; bash \"$r/hooks/scripts/scan-pii.sh\"'",
        "powershell": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"$r=if($env:CLAUDE_PLUGIN_ROOT){$env:CLAUDE_PLUGIN_ROOT}else{$env:PLUGIN_ROOT}; & \\\"$r/hooks/scripts/scan-pii.ps1\\\"\"",
        "cwd": ".",
        "env": {
          "SCAN_MODE": "warn",
          "SCAN_SCOPE": "diff"
        },
        "timeoutSec": 60
      }
    ]
  }
}
